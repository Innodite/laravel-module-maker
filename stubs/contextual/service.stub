<?php

declare(strict_types=1);

namespace {{{ namespace }}};

use {{{ serviceInterfaceNamespace }}};
use {{{ repositoryInterfaceNamespace }}};

class {{{ serviceName }}} implements {{{ serviceInterfaceName }}}
{
    public function __construct(
        private readonly {{{ repositoryInterfaceName }}} ${{{ repositoryInstance }}},
    ) {}

    public function paginate(array $filters = []): mixed
    {
        return $this->{{{ repositoryInstance }}}->paginate($filters);
    }

    public function list(array $filters = []): mixed
    {
        return $this->{{{ repositoryInstance }}}->list($filters);
    }

    public function findById(string $id): mixed
    {
        return $this->{{{ repositoryInstance }}}->findById($id);
    }

    public function create(array $data): mixed
    {
        return $this->{{{ repositoryInstance }}}->create($data);
    }

    public function update(string $id, array $data): mixed
    {
        return $this->{{{ repositoryInstance }}}->update($id, $data);
    }

    public function delete(string $id): bool
    {
        return $this->{{{ repositoryInstance }}}->delete($id);
    }

    /**
     * Devuelve a la vida un registro eliminado.
     *
     * ⛔ **Si al restaurar esto hay que restaurar algo más, se escribe aquí.** La cascada es una
     * decisión de negocio —qué arrastra qué— y por eso vive en el Service y no en el Repository ni
     * en el modelo: ahí sería una regla escondida que nadie encuentra al leer el flujo.
     */
    public function restore(string $id): bool
    {
        return $this->{{{ repositoryInstance }}}->restore($id);
    }

    /**
     * Lo borra de la base de datos, sin vuelta atrás.
     *
     * ⛔ **Antes de borrar del todo, comprueba aquí lo que cuelga de este registro.** Es el único
     * punto donde se puede negar: cuando llega al repositorio, ya es tarde.
     */
    public function forceDelete(string $id): bool
    {
        return $this->{{{ repositoryInstance }}}->forceDelete($id);
    }
}
