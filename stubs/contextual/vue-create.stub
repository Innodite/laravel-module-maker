<script setup>
/**
 * El alta de {{{ subFeatureLabel }}} — un **modal** sobre el listado, no una pantalla aparte.
 *
 * No navega a ningún sitio: avisa al índice con dos eventos y él decide qué hacer. `guardado` para
 * que recargue la tabla, `cerrar` para que la descarte. Ese reparto es lo que mantiene el estado de
 * «qué estoy mirando» en un solo componente.
 *
 * **La validación no se escribe aquí.** El 422 que llega en el `catch` viene del FormRequest del
 * back, y este formulario solo lo reparte por campo. Duplicar las reglas en el navegador crea dos
 * verdades que se separan a la primera.
 */
import { ref } from 'vue'
import { useModuleContext } from '@/Composables/useModuleContext'
import { usePermissions } from '@/Composables/usePermissions'
import { useAvisos } from '@/Composables/useAvisos'
import InnoditeModal from '@/Components/InnoditeModal.vue'

const emit = defineEmits(['guardado', 'cerrar'])

const { contextRoute } = useModuleContext()
const { can }          = usePermissions()

/**
 * Los avisos no se pintan aquí: el componente que los muestra vive en el listado y el estado es
 * compartido. Por eso un mensaje lanzado desde este formulario sigue en pantalla después de que el
 * modal se cierre — que es exactamente cuando hay algo que contar.
 */
const { exito, error: avisarError, mensajeDeError } = useAvisos()

const form     = ref({})
const errors   = ref({})
const saving   = ref(false)

/**
 * Guardar recorre el patrón entero. Conviene leerlo una vez, porque es el mismo en las cuatro
 * pantallas y en cualquier módulo que generes después:
 *
 *     este POST  →  la ruta exige `{{{ permViewStore }}}`
 *                →  el FormRequest de alta valida la entrada
 *                →  el Controller delega en el Service
 *                →  el Service pregunta al Repository
 *                →  y solo el Repository toca el modelo
 *
 * Ninguna de esas capas se salta: el Controller no consulta el modelo y el Service tampoco. Es la
 * regla que hace que un cambio de persistencia se toque en un archivo y no en cuatro.
 */
async function submit() {
    if (!can('{{{ permViewStore }}}')) return

    saving.value = true
    errors.value = {}

    try {
        await window.axios.post(route(contextRoute('{{{ routeBase }}}.store')), form.value)
        exito('Registro creado.')
        emit('guardado')
    } catch (err) {
        if (err.response?.status === 422) {
            // Los errores de validación se reparten por campo, junto al campo. Un aviso general
            // que diga «revisa el formulario» obliga a buscar cuál.
            errors.value = err.response.data.errors ?? {}
        } else {
            avisarError(mensajeDeError(err, 'Error al guardar el registro.'))
        }
        console.error('[{{{ vueComponentName }}}]', err)
    } finally {
        saving.value = false
    }
}

function goBack() {
    emit('cerrar')
}
</script>

<template>
    <!--
        El ancho y el número de columnas son de esta funcionalidad, no del componente.

        `columnas` reparte los campos en rejilla en vez de apilarlos, que es lo que evita el scroll
        en un alta de diez campos. Un campo que necesite la fila entera se marca donde se declara:

            <div class="sm:col-span-2"> … </div>

        Y cuando ni con rejilla cabe, el mismo modal hace de asistente — sin cambiar nada más:

            <InnoditeModal :pasos="['Datos generales', 'Detalle']" …>
                <template #default="{ paso }">
                    <div v-show="paso === 0" class="sm:col-span-2"> …primer grupo… </div>
                    <div v-show="paso === 1" class="sm:col-span-2"> …segundo grupo… </div>
                </template>
            </InnoditeModal>
    -->
    <InnoditeModal
        titulo="Nuevo {{{ subFeatureLabel }}}"
        tamano="lg"
        :columnas="2"
        :guardando="saving"
        texto-guardar="Guardar"
        @guardar="submit"
        @cerrar="goBack"
    >
        <!--
            TODO: Añade aquí los campos del formulario. Este es el molde de uno — etiqueta, control
            enlazado a `form`, y el error de ESE campo debajo, que es de donde sale el 422:

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                <input
                    v-model="form.name"
                    type="text"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
                />
                <p v-if="errors.name" class="mt-1 text-xs text-red-500">{{ errors.name[0] }}</p>
            </div>

            El paquete no los escribe por ti a propósito: conoce la forma de una subfuncionalidad,
            no los campos de tu negocio. Lo que sí deja resuelto es todo lo de alrededor.
        -->
        <p class="sm:col-span-2 text-sm text-gray-400">
            Sin campos todavía. Añádelos en <code class="text-xs">{{{ vueComponentName }}}.vue</code>.
        </p>

    </InnoditeModal>
</template>
