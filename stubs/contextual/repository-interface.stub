<?php

declare(strict_types=1);

namespace {{{ namespace }}};

/**
 * El contrato del repositorio — **la única capa que habla con la base de datos**.
 *
 * Todo lo que hay por encima —controlador y servicio— trata el identificador como un **dato**: un
 * `string`, porque la clave primaria de toda tabla generada es un ULID. Aquí, y solo aquí, ese dato
 * se convierte en un registro de Eloquent.
 *
 * Esa frontera es la que permite cambiar de dónde salen los datos sin tocar el negocio, y no es una
 * recomendación: el `ScaffoldTest` de esta subfuncionalidad falla si el servicio importa Eloquent.
 */
interface {{{ repositoryInterfaceName }}}
{
    public function paginate(array $filters = []): mixed;
    public function list(array $filters = []): mixed;
    public function findById(string $id): mixed;
    public function create(array $data): mixed;
    public function update(string $id, array $data): mixed;
    public function delete(string $id): bool;

    public function findTrashed(string $id): mixed;

    public function restore(string $id): bool;

    public function forceDelete(string $id): bool;
}
