<script setup>
/**
 * La edición de {{{ subFeatureLabel }}} — el mismo modal que el alta, con el registro ya cargado.
 *
 * Recibe el identificador por prop y avisa al índice con `guardado` y `cerrar`. No navega: de las
 * seis rutas que esta subfuncionalidad declara, solo `index` devuelve una pantalla.
 */
import { computed, ref, onMounted } from 'vue'
import { usePage } from '@inertiajs/vue3'
import InnoditeModal from '@/Components/InnoditeModal.vue'

const emit = defineEmits(['guardado', 'cerrar'])

const props = defineProps({
    id: { type: [Number, String], required: true },
})

/**
 * Los permisos del usuario, tal y como el backend los comparte por Inertia.
 *
 * Van escritos aquí, en la propia pantalla, y no importados de un composable del generador. Son
 * tres líneas que no cambian nunca, y a cambio esta vista **no depende de ningún archivo que el
 * paquete tenga que dejar en tu proyecto** — uno copiado deja de actualizarse el día que se copia.
 *
 * Si prefieres tu propio composable, sustitúyelas: esto es un punto de partida, no una jaula.
 * Lo único imprescindible es que `HandleInertiaRequests` comparta `auth.permissions`; el
 * diagnóstico del paquete lo exige y da el bloque exacto (`php artisan innodite:doctor`).
 */
const permisos = computed(() => usePage().props?.auth?.permissions ?? [])
const can = (permiso) => permisos.value.includes(permiso)

/** El componente que pinta estos avisos está montado en el listado, y el estado es compartido. */
/**
 * Los mensajes de la pantalla, sin `alert()` y sin depender de ningún componente externo.
 *
 * `error` es el fallo que impide ver los datos y se queda escrito; `aviso` es la confirmación de
 * que algo salió bien. Son dos cosas distintas y por eso conviven — un fallo que deja la tabla
 * vacía no es un mensaje que se desvanece.
 */
const aviso = ref(null)

function avisar(mensaje) {
    aviso.value = mensaje
    setTimeout(() => (aviso.value = null), 5000)
}

/** El mensaje que venga del servidor, y si no viene, el nuestro. */
function mensajeDeError(err, porDefecto) {
    return err?.response?.data?.message ?? porDefecto
}

const form    = ref({})
const errors  = ref({})
const loading = ref(false)
const saving  = ref(false)

/**
 * Cargar el registro pasa por las mismas capas que guardarlo:
 *
 *     este GET  →  la ruta exige `{{{ permViewShow }}}`
 *               →  el Controller delega en el Service
 *               →  el Service pregunta al Repository
 *               →  y solo el Repository toca el modelo
 *
 * El identificador viaja como `string`: la clave primaria del modelo generado es un ULID, no un
 * entero autoincremental, y la firma de las cuatro capas lo declara así.
 */
async function fetchItem() {
    loading.value = true
    try {
        const { data } = await window.axios.get(
            window.route('{{{ routeName }}}.show', { id: props.id })
        )
        form.value = { ...data }
    } catch (err) {
        // El modal se cierra, pero el aviso se queda: el estado no vive en este componente.
        error.value = mensajeDeError(err, 'No se pudo cargar el registro.')
        goBack()
    } finally {
        loading.value = false
    }
}

async function submit() {
    if (!can('{{{ permViewUpdate }}}')) return

    saving.value = true
    errors.value = {}

    try {
        await window.axios.put(
            window.route('{{{ routeName }}}.update', { id: props.id }),
            form.value
        )
        avisar('Registro actualizado.')
        emit('guardado')
    } catch (err) {
        if (err.response?.status === 422) {
            // Cada mensaje del 422 va junto a su campo; el aviso general queda para lo que no
            // pertenece a ninguno. Lo emite el FormRequest de actualización, que es una clase
            // distinta de la del alta: las reglas de crear y las de editar rara vez coinciden.
            errors.value = err.response.data.errors ?? {}
        } else {
            error.value = mensajeDeError(err, 'Error al actualizar el registro.')
        }
        console.error('[{{{ vueComponentName }}}]', err)
    } finally {
        saving.value = false
    }
}

function goBack() {
    emit('cerrar')
}

onMounted(() => fetchItem())
</script>

<template>
    <!--
        Mismo tamaño y misma rejilla que el alta, a propósito: es el mismo formulario con los
        valores puestos, y que el usuario lo reconozca vale más que afinar cada ventana por su lado.

        Si el alta pasó a asistente por no caber, esta pantalla pasa igual — con los mismos `pasos`.
    -->
    <InnoditeModal
        titulo="Editar {{{ subFeatureLabel }}}"
        tamano="lg"
        :columnas="2"
        :cargando="loading"
        :guardando="saving"
        texto-guardar="Actualizar"
        @guardar="submit"
        @cerrar="goBack"
    >
        <!--
            TODO: Añade aquí los campos, enlazados a `form` igual que en el alta:

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                <input
                    v-model="form.name"
                    type="text"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
                />
                <p v-if="errors.name" class="mt-1 text-xs text-red-500">{{ errors.name[0] }}</p>
            </div>

            El formulario se rellena solo: `fetchItem()` vuelca la respuesta en `form`, así que cada
            `v-model` encuentra su valor sin que haya que asignarlo campo por campo.
        -->
        <p class="sm:col-span-2 text-sm text-gray-400">
            Sin campos todavía. Añádelos en <code class="text-xs">{{{ vueComponentName }}}.vue</code>.
        </p>

    </InnoditeModal>
</template>
