<?php

declare(strict_types=1);

namespace {{{ namespace }}};

use Illuminate\Support\Facades\Schema;

/**
 * Temas 1 y 2 — el esquema de {{{ subFeature }}}: sus tablas y las columnas de su contrato.
 *
 * **Dos pruebas fijas, y ninguna crece.** Una tabla nueva o una columna nueva se declaran en el
 * manifiesto y estas dos las recorren sin tocarse. Ese es el techo del contrato: la suite no engorda
 * con cada campo que gana el negocio.
 *
 * Se mira la conexión que declara el manifiesto —la misma del modelo y la de sus seeders—, y no la
 * de por defecto: en multitenant esa diferencia es la que separa comprobar la base correcta de
 * comprobar otra y pasar en verde.
 */
final class {{{ schemaName }}} extends {{{ baseName }}}
{
    /**
     * El esquema lo levanta **el seeder de stage**, no `migrate`.
     *
     * ⛔ Y no `RefreshDatabase`: ese recorre `database/migrations`, donde las migraciones de un
     * módulo **no viven**. Con él, estas dos pruebas fallarían siempre por buscar una tabla que
     * nadie creó — no por un defecto de la subfuncionalidad. El vehículo del despliegue es el
     * seeder, y probar el esquema es ejecutar el mismo camino que corre en el servidor (R75).
     */
    protected function setUp(): void
    {
        parent::setUp();

        $this->levantarSubfuncionalidad();
    }

    /**
     * Qué prueba: que existen las tablas de la subfuncionalidad.
     * Resultado esperado: todas las del manifiesto, presentes.
     * Por qué existe: si falta una, todo lo que se apoye en ella falla más tarde y más lejos —
     *   normalmente en una pantalla, ya en el servidor.
     */
    public function test_las_tablas_de_la_subfuncionalidad_existen(): void
    {
        foreach (array_keys({{{ contractName }}}::TABLES) as $tabla) {
            $this->assertTrue(
                Schema::connection({{{ contractName }}}::CONNECTION)->hasTable($tabla),
                "FALLA: la tabla '{$tabla}' no existe. · FIX: comprueba que su migración está en el "
                . 'trait MigrationsList de la subfuncionalidad y vuelve a correr el seeder de stage.'
            );
        }
    }

    /**
     * Qué prueba: que están todas las columnas del contrato.
     * Resultado esperado: ninguna ausente.
     * Por qué existe: una columna que alguien más consume y que dejó de crearse no rompe al migrar;
     *   rompe al leerla, y solo en el caso que la usa.
     */
    public function test_todas_las_columnas_del_contrato_existen(): void
    {
        foreach ({{{ contractName }}}::TABLES as $tabla => $columnas) {
            foreach ($columnas as $columna) {
                $this->assertTrue(
                    Schema::connection({{{ contractName }}}::CONNECTION)->hasColumn($tabla, $columna),
                    "FALLA: falta la columna '{$tabla}.{$columna}'. · FIX: si es nueva, va como delta "
                    . 'en el trait InlineAlters con su guarda hasColumn(); si es de creación, en la '
                    . 'migración _final de la tabla.'
                );
            }
        }
    }
}
