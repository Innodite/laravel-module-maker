<script setup>
/**
 * La pantalla de {{{ subFeatureLabel }}} — y **la única** de esta subfuncionalidad.
 *
 * Crear, ver y editar ocurren en modales sobre esta misma tabla, no en pantallas aparte. Es lo que
 * encaja con las rutas que el paquete genera: de las seis, solo `index` devuelve una pantalla; las
 * otras cinco devuelven datos. Con pantallas separadas harían falta rutas y permisos que no existen
 * —y esa es exactamente la grieta por la que antes se le pasaba a `route()` el nombre de un permiso,
 * porque no había ningún nombre de ruta que pasarle.
 *
 * **Cómo se conecta esto con el resto del patrón**, que es lo que conviene leer una vez:
 *
 *     esta pantalla  →  pide `list`      →  la ruta exige su permiso
 *                                        →  el Controller delega en el Service
 *                                        →  el Service pregunta al Repository
 *                                        →  y solo el Repository toca el modelo
 *
 * Los `can()` de abajo son permisos **de vista**, distintos de los que protegen cada ruta: ocultar un
 * botón no protege el endpoint, y proteger el endpoint no limpia la pantalla. Se emiten los dos.
 */
import { computed, ref, onMounted } from 'vue'
import { usePage } from '@inertiajs/vue3'
{{{ layoutImport }}}import {{{ vueComponentBase }}}Create from './{{{ vueComponentBase }}}Create.vue'
import {{{ vueComponentBase }}}Edit from './{{{ vueComponentBase }}}Edit.vue'
import {{{ vueComponentBase }}}Show from './{{{ vueComponentBase }}}Show.vue'
{{{ layoutOption }}}
/**
 * Los permisos del usuario, tal y como el backend los comparte por Inertia.
 *
 * Van escritos aquí, en la propia pantalla, y no importados de un composable del generador. Son
 * tres líneas que no cambian nunca, y a cambio esta vista **no depende de ningún archivo que el
 * paquete tenga que dejar en tu proyecto** — uno copiado deja de actualizarse el día que se copia.
 *
 * Si prefieres tu propio composable, sustitúyelas: esto es un punto de partida, no una jaula.
 * Lo único imprescindible es que `HandleInertiaRequests` comparta `auth.permissions`; el
 * diagnóstico del paquete lo exige y da el bloque exacto (`php artisan innodite:doctor`).
 */
const permisos = computed(() => usePage().props?.auth?.permissions ?? [])
const can = (permiso) => permisos.value.includes(permiso)

/**
 * Los mensajes de la pantalla, sin `alert()` y sin depender de ningún componente externo.
 *
 * `error` es el fallo que impide ver los datos y se queda escrito; `aviso` es la confirmación de
 * que algo salió bien. Son dos cosas distintas y por eso conviven — un fallo que deja la tabla
 * vacía no es un mensaje que se desvanece.
 */
const aviso = ref(null)

function avisar(mensaje) {
    aviso.value = mensaje
    setTimeout(() => (aviso.value = null), 5000)
}

/** El mensaje que venga del servidor, y si no viene, el nuestro. */
function mensajeDeError(err, porDefecto) {
    return err?.response?.data?.message ?? porDefecto
}

const items   = ref([])
const loading = ref(false)
const meta    = ref({ current_page: 1, last_page: 1, total: 0 })
const error   = ref(null)

/** Qué modal está abierto y sobre qué registro. `null` = ninguno. */
const modal = ref(null)
const seleccionado = ref(null)

/**
 * El listado pide `list`, no `index`.
 *
 * Son dos rutas distintas a propósito, y confundirlas no da error: `index` devuelve la **pantalla**
 * por Inertia, así que la petición respondía 200 con el HTML de la página y la tabla se quedaba
 * vacía para siempre — que se lee igual que «todavía no hay datos».
 */
async function fetchItems(page = 1) {
    loading.value = true
    error.value   = null
    try {
        const { data } = await window.axios.get(window.route('{{{ routeName }}}.list'), {
            params: { page }
        })
        items.value = data.data
        meta.value  = {
            current_page: data.current_page,
            last_page:    data.last_page,
            total:        data.total,
        }
    } catch (err) {
        error.value = err.response?.data?.message ?? 'Error al cargar los datos.'
        console.error('[{{{ vueComponentName }}}]', err)
    } finally {
        loading.value = false
    }
}

async function destroy(id) {
    // La confirmación se pide en la propia pantalla, con un <dialog> nativo del navegador: no
    // bloquea como `confirm()`, se puede estilar y se puede probar. Sin componentes de terceros.
    if (! await pedirConfirmacion()) return

    try {
        await window.axios.delete(window.route('{{{ routeName }}}.destroy', { id }))
        avisar('Registro eliminado.')
        await fetchItems(meta.value.current_page)
    } catch (err) {
        error.value = mensajeDeError(err, 'No se pudo eliminar el registro.')
    }
}

async function restore(id) {
    // Restaurar no pide confirmación: no destruye nada, y una ventana de por medio en la acción que
    // arregla un error hace que la gente deje de usarla y pida el arreglo por otro lado.
    try {
        await window.axios.patch(window.route('{{{ routeName }}}.restore', { id }))
        avisar('Registro restaurado.')
        await fetchItems(meta.value.current_page)
    } catch (err) {
        error.value = mensajeDeError(err, 'No se pudo restaurar el registro.')
    }
}

function abrirCrear() {
    seleccionado.value = null
    modal.value = 'crear'
}

function abrirEditar(id) {
    seleccionado.value = id
    modal.value = 'editar'
}

function abrirDetalle(id) {
    seleccionado.value = id
    modal.value = 'ver'
}

function cerrarModal() {
    modal.value = null
    seleccionado.value = null
}

/** Tras guardar, el modal se cierra y la tabla se recarga en la página donde estaba. */
async function alGuardar() {
    cerrarModal()
    await fetchItems(meta.value.current_page)
}

onMounted(() => fetchItems())

/**
 * La confirmación, con el `<dialog>` del navegador.
 *
 * Devuelve una promesa que se resuelve cuando el usuario elige, así que quien la llama la espera
 * igual que esperaría a `confirm()` — pero sin bloquear la página, con una ventana que se puede
 * estilar, y que una prueba puede abrir y pulsar.
 */
const dialogo = ref(null)
let resolverConfirmacion = null

function pedirConfirmacion() {
    dialogo.value?.showModal()

    return new Promise((resolve) => (resolverConfirmacion = resolve))
}

function responder(respuesta) {
    dialogo.value?.close()
    resolverConfirmacion?.(respuesta)
    resolverConfirmacion = null
}
</script>

<template>
    <div class="p-6">

        <!-- Cabecera -->
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-semibold text-gray-800">{{{ subFeatureLabel }}}</h1>
            <button
                v-if="can('{{{ permViewStore }}}')"
                data-test="boton-crear"
                @click="abrirCrear"
                class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition"
            >
                + Nuevo {{{ subFeatureLabel }}}
            </button>
        </div>

        <!-- Error -->
        <div v-if="error" class="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
            {{ error }}
        </div>

        <!-- Loader -->
        <div v-if="loading" class="flex justify-center py-12">
            <span class="text-gray-400 text-sm">Cargando...</span>
        </div>

        <template v-else>

            <!--
                Tabla.

                TODO: Añade aquí las columnas de tu negocio. Cada una es una cabecera y su celda:

                    <th class="px-4 py-3 text-left font-medium text-gray-600">Nombre</th>
                    ...
                    <td class="px-4 py-3 text-gray-800">{{ item.name }}</td>

                Recuerda subir el `colspan` de la fila vacía al añadirlas. El paquete deja las
                genéricas —el identificador y las fechas— porque son las únicas que existen en
                cualquier subfuncionalidad; los campos del negocio los conoces tú.
            -->
            <div class="overflow-x-auto rounded-lg border border-gray-200">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-medium text-gray-600">#</th>
                            <th class="px-4 py-3 text-left font-medium text-gray-600">ID</th>
                            <th class="px-4 py-3 text-left font-medium text-gray-600">Creado</th>
                            <th class="px-4 py-3 text-right font-medium text-gray-600">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-white">
                        <tr v-if="items.length === 0">
                            <td colspan="4" class="px-4 py-8 text-center text-gray-400">
                                No hay registros para mostrar.
                            </td>
                        </tr>
                        <tr
                            v-for="(item, index) in items"
                            :key="item.id"
                            class="hover:bg-gray-50 transition"
                        >
                            <td class="px-4 py-3 text-gray-500">
                                {{ (meta.current_page - 1) * 15 + index + 1 }}
                            </td>
                            <td class="px-4 py-3">
                                <span
                                    v-if="can('{{{ permViewShow }}}')"
                                    data-test="enlace-ver"
                                    class="text-blue-600 cursor-pointer hover:underline"
                                    @click="abrirDetalle(item.id)"
                                >
                                    {{ item.id }}
                                </span>
                                <span v-else class="text-gray-500">{{ item.id }}</span>
                            </td>
                            <td class="px-4 py-3 text-gray-500">{{ item.created_at }}</td>
                            <td class="px-4 py-3 text-right space-x-3">
                                <button
                                    v-if="can('{{{ permViewUpdate }}}')"
                                    data-test="boton-editar"
                                    @click="abrirEditar(item.id)"
                                    class="text-blue-600 hover:underline text-xs"
                                >
                                    Editar
                                </button>
                                <button
                                    v-if="can('{{{ permViewDestroy }}}') && !item.deleted_at"
                                    data-test="boton-eliminar"
                                    @click="destroy(item.id)"
                                    class="text-red-500 hover:underline text-xs"
                                >
                                    Eliminar
                                </button>
                                <button
                                    v-if="can('{{{ permViewRestore }}}') && item.deleted_at"
                                    data-test="boton-restaurar"
                                    @click="restore(item.id)"
                                    class="text-emerald-600 hover:underline text-xs"
                                >
                                    Restaurar
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="flex items-center justify-between mt-4">
                <span class="text-xs text-gray-400">Total: {{ meta.total }} registros</span>
                <div v-if="meta.last_page > 1" class="flex space-x-1">
                    <button
                        v-for="p in meta.last_page"
                        :key="p"
                        @click="fetchItems(p)"
                        :class="p === meta.current_page
                            ? 'bg-blue-600 text-white'
                            : 'bg-white text-gray-600 border border-gray-300 hover:bg-gray-50'"
                        class="px-3 py-1 rounded text-xs transition"
                    >
                        {{ p }}
                    </button>
                </div>
            </div>

        </template>

        <!--
            Los tres modales, sobre esta misma pantalla.

            Cada uno recibe el identificador y avisa cuando termina; el índice se encarga de cerrar y
            de recargar la tabla. Así el estado de «qué registro estoy mirando» vive en un solo sitio.
        -->
        <{{{ vueComponentBase }}}Create
            v-if="modal === 'crear'"
            @guardado="alGuardar"
            @cerrar="cerrarModal"
        />

        <{{{ vueComponentBase }}}Edit
            v-if="modal === 'editar'"
            :id="seleccionado"
            @guardado="alGuardar"
            @cerrar="cerrarModal"
        />

        <{{{ vueComponentBase }}}Show
            v-if="modal === 'ver'"
            :id="seleccionado"
            @editar="abrirEditar"
            @eliminado="alGuardar"
            @cerrar="cerrarModal"
        />

        <!-- El aviso de que algo salió bien. Se va solo a los cinco segundos. -->
        <p
            v-if="aviso"
            data-test="aviso"
            class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"
        >
            {{ aviso }}
        </p>

        <!--
            La confirmación de borrado, con el <dialog> del navegador.

            Nativo a propósito: no hace falta ningún componente, no bloquea la página como
            `confirm()`, se puede estilar y una prueba puede abrirlo y pulsar sus botones.
        -->
        <dialog ref="dialogo" class="rounded-xl p-0 backdrop:bg-black/40">
            <div class="w-80 p-5">
                <h2 class="text-base font-semibold text-gray-800">Eliminar registro</h2>
                <p class="mt-2 text-sm text-gray-600">
                    El registro deja de aparecer, y se puede restaurar después.
                </p>
                <div class="mt-5 flex justify-end space-x-2">
                    <button
                        data-test="confirmar-no"
                        @click="responder(false)"
                        class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800"
                    >
                        Cancelar
                    </button>
                    <button
                        data-test="confirmar-si"
                        @click="responder(true)"
                        class="rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700"
                    >
                        Eliminar
                    </button>
                </div>
            </div>
        </dialog>
    </div>
</template>
