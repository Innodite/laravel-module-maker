<script setup>
/**
 * El detalle de {{{ subFeatureLabel }}} — un modal de lectura, con sus dos acciones en el pie.
 *
 * No decide nada por su cuenta: «Editar» emite `editar` con el identificador y el índice abre el
 * modal correspondiente; «Eliminar» emite `eliminado` y el índice recarga la tabla. Así hay un solo
 * componente que sabe qué registro se está mirando.
 */
import { computed, ref, onMounted } from 'vue'
import { usePage } from '@inertiajs/vue3'
import InnoditeModal from '@/Components/InnoditeModal.vue'

const emit = defineEmits(['editar', 'eliminado', 'cerrar'])

const props = defineProps({
    id: { type: [Number, String], required: true },
})

/**
 * Los permisos del usuario, tal y como el backend los comparte por Inertia.
 *
 * Van escritos aquí, en la propia pantalla, y no importados de un composable del generador. Son
 * tres líneas que no cambian nunca, y a cambio esta vista **no depende de ningún archivo que el
 * paquete tenga que dejar en tu proyecto** — uno copiado deja de actualizarse el día que se copia.
 *
 * Si prefieres tu propio composable, sustitúyelas: esto es un punto de partida, no una jaula.
 * Lo único imprescindible es que `HandleInertiaRequests` comparta `auth.permissions`; el
 * diagnóstico del paquete lo exige y da el bloque exacto (`php artisan innodite:doctor`).
 */
const permisos = computed(() => usePage().props?.auth?.permissions ?? [])
const can = (permiso) => permisos.value.includes(permiso)

/** Avisos y confirmación: los pinta el componente montado en el listado. */
/**
 * Los mensajes de la pantalla, sin `alert()` y sin depender de ningún componente externo.
 *
 * `error` es el fallo que impide ver los datos y se queda escrito; `aviso` es la confirmación de
 * que algo salió bien. Son dos cosas distintas y por eso conviven — un fallo que deja la tabla
 * vacía no es un mensaje que se desvanece.
 */
const aviso = ref(null)

function avisar(mensaje) {
    aviso.value = mensaje
    setTimeout(() => (aviso.value = null), 5000)
}

/** El mensaje que venga del servidor, y si no viene, el nuestro. */
function mensajeDeError(err, porDefecto) {
    return err?.response?.data?.message ?? porDefecto
}

const item    = ref(null)
const loading = ref(false)

/**
 * El recorrido es el mismo que en las otras pantallas — y el permiso, distinto:
 *
 *     este GET  →  la ruta exige `{{{ permViewShow }}}`
 *               →  el Controller delega en el Service
 *               →  el Service pregunta al Repository
 *               →  y solo el Repository toca el modelo
 *
 * Cada una de las seis acciones tiene su permiso propio. Ver no es editar, y editar no es borrar:
 * por eso el `can()` de abajo no repite el de arriba.
 */
async function fetchItem() {
    loading.value = true
    try {
        const { data } = await window.axios.get(
            window.route('{{{ routeName }}}.show', { id: props.id })
        )
        item.value = data
    } catch (err) {
        // Se cierra el modal y el aviso permanece: el estado es compartido, no de este componente.
        error.value = mensajeDeError(err, 'No se pudo cargar el registro.')
        goBack()
    } finally {
        loading.value = false
    }
}

async function destroy() {
    if (!can('{{{ permViewDestroy }}}')) return

    // Con un <dialog> nativo: no bloquea el navegador como `confirm()`, se puede estilar y se
    // puede probar — y no depende de ningún componente de terceros.
    if (! await pedirConfirmacion()) return

    try {
        await window.axios.delete(
            window.route('{{{ routeName }}}.destroy', { id: props.id })
        )
        avisar('Registro eliminado.')
        emit('eliminado')
    } catch (err) {
        error.value = mensajeDeError(err, 'No se pudo eliminar el registro.')
    }
}

function goToEdit() {
    emit('editar', props.id)
}

function goBack() {
    emit('cerrar')
}

onMounted(() => fetchItem())

/**
 * La confirmación, con el `<dialog>` del navegador.
 *
 * Devuelve una promesa que se resuelve cuando el usuario elige, así que quien la llama la espera
 * igual que esperaría a `confirm()` — pero sin bloquear la página, con una ventana que se puede
 * estilar, y que una prueba puede abrir y pulsar.
 */
const dialogo = ref(null)
let resolverConfirmacion = null

function pedirConfirmacion() {
    dialogo.value?.showModal()

    return new Promise((resolve) => (resolverConfirmacion = resolve))
}

function responder(respuesta) {
    dialogo.value?.close()
    resolverConfirmacion?.(respuesta)
    resolverConfirmacion = null
}
</script>

<template>
    <!--
        Leer ocupa menos que rellenar: este modal es más estrecho que el del formulario y se cierra
        clicando fuera, cosa que el alta no hace — ahí un clic despistado tiraría lo escrito.

        El pie va por slot porque aquí las acciones no son «guardar» y «cancelar».
    -->
    <InnoditeModal
        titulo="Detalle: {{{ subFeatureLabel }}}"
        tamano="md"
        :columnas="2"
        :cargando="loading"
        cerrar-al-clicar-fondo
        @cerrar="goBack"
    >
        <template v-if="item">
            <!--
                TODO: Añade aquí las filas del registro. Cada una es una etiqueta y su valor:

                <div>
                    <span class="block text-xs font-medium text-gray-500">Nombre</span>
                    <span class="text-sm text-gray-800">{{ item.name }}</span>
                </div>

                Van en la misma rejilla de dos columnas que el formulario, así que el detalle se lee
                donde estaban los campos. Un valor largo —una descripción, una dirección— se marca
                con `class="sm:col-span-2"` para que ocupe la fila entera.
            -->
            <div>
                <span class="block text-xs font-medium text-gray-500">ID</span>
                <span class="text-sm text-gray-800">{{ item.id }}</span>
            </div>

            <div>
                <span class="block text-xs font-medium text-gray-500">Creado</span>
                <span class="text-sm text-gray-800">{{ item.created_at }}</span>
            </div>

            <div>
                <span class="block text-xs font-medium text-gray-500">Actualizado</span>
                <span class="text-sm text-gray-800">{{ item.updated_at }}</span>
            
        <!--
            La confirmación de borrado, con el <dialog> del navegador. Nativo a propósito: no hace
            falta ningún componente y una prueba puede abrirlo y pulsar sus botones.
        -->
        <dialog ref="dialogo" class="rounded-xl p-0 backdrop:bg-black/40">
            <div class="w-80 p-5">
                <h2 class="text-base font-semibold text-gray-800">Eliminar registro</h2>
                <p class="mt-2 text-sm text-gray-600">Esta acción no se puede deshacer.</p>
                <div class="mt-5 flex justify-end space-x-2">
                    <button data-test="confirmar-no" @click="responder(false)"
                        class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800">Cancelar</button>
                    <button data-test="confirmar-si" @click="responder(true)"
                        class="rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">Eliminar</button>
                </div>
            </div>
        </dialog>

    </div>
        </template>

        <p v-else-if="!loading" class="sm:col-span-2 text-center text-sm text-gray-400 py-6">
            Registro no encontrado.
        </p>

        <!--
            Los dos botones se ocultan si el usuario no tiene el permiso, y aun así la ruta lo exige
            por su cuenta. Son dos comprobaciones distintas y las dos hacen falta: ocultar el botón
            no protege el endpoint, y proteger el endpoint no limpia la pantalla.
        -->
        <template #pie>
            <button
                type="button"
                class="mr-auto rounded-lg border border-gray-300 bg-white px-5 py-2 text-sm text-gray-600 transition hover:bg-gray-50"
                @click="goBack"
            >
                Cerrar
            </button>
            <button
                v-if="can('{{{ permViewUpdate }}}')"
                type="button"
                data-test="boton-editar"
                class="rounded-lg bg-blue-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-blue-700"
                @click="goToEdit"
            >
                Editar
            </button>
            <button
                v-if="can('{{{ permViewDestroy }}}')"
                type="button"
                data-test="boton-eliminar"
                class="rounded-lg bg-red-500 px-5 py-2 text-sm font-medium text-white transition hover:bg-red-600"
                @click="destroy"
            >
                Eliminar
            </button>
        </template>

    </InnoditeModal>
</template>
